{
  "name": "golftraining",
  "private": true,
  "description": "Golfträning PWA. npm test körs offline med Node:s inbyggda testkörare. test:emulator kör synken mot Firestore-emulatorn (demo-golfrounds) med Golfrounds regler.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:emulator": "G=${GOLFROUNDS_DIR:-$HOME/Code/golfrounds}; node $G/scripts/emulator-lock.js firebase emulators:exec --config $G/firebase.json --only firestore --project demo-golfrounds \"node $PWD/tests/emulator/sync.emu.mjs\"",
    "deploy:preview": "firebase hosting:channel:deploy preview --only golftraining --expires 30d",
    "deploy": "firebase deploy --only hosting:golftraining"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0"
  }
}
